title: $:/plugins/litapp/blog/templates/rss
type: text/vnd.tiddlywiki

\whitespace trim
<$wikify name="siteUrl" text={{$:/config/feeds/SiteBaseUrl}} output="text">
<$wikify name="wikifiedTitle" text={{$:/config/feeds/title}} output="text">
<$wikify name="wikifiedDescription" text={{$:/config/feeds/description}} output="text">
`<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>`<$text text={{{ [<wikifiedTitle>trim[]encodehtml[]] }}}/>`</title>
  <description>`<$text text={{{ [<wikifiedDescription>trim[]encodehtml[]] }}}/>`</description>
  <link>`<$text text=<<siteUrl>> />`</link>
  <atom:link rel="self" type="application/rss+xml" href="`<$text text={{{ [<siteUrl>removesuffix[/]addsuffix[/rss.xml]] }}}/>`" />
`<$list filter={{$:/config/feeds/filter}} variable="t">
`    <item>
      <title>`<$text text={{{ [<t>get[title]trim[]encodehtml[]] }}}/>`</title>
      <description>`<$text text={{{ [<t>get[description]trim[]encodehtml[]] }}}/>`</description>
      <pubDate>`<$view tiddler=<<t>> field="published" format="date" template="[UTC]ddd, 0DD MMM YYYY 0hh:0mm:0ss"/>` GMT</pubDate>
      <link>`<$text text={{{ [<t>encodeuricomponent[]addsuffix[.html]addprefix<siteUrl>trim[]] }}}/>`</link>
      <guid isPermaLink="true">`<$text text={{{ [<t>encodeuricomponent[]addsuffix[.html]addprefix<siteUrl>trim[]] }}}/>`</guid>
    </item>
`</$list>
`</channel>
</rss>`
</$wikify>
</$wikify>
</$wikify>
