caption: Home
title: $:/plugins/litapp/blog/templates/home
type: text/vnd.tiddlywiki

<section class="home-sections">
  <div class="articles-column">
    <h2 class="section-title">Latest Articles</h2>
    <$list filter="[has:field[published]!has:field[pixelfed]!sort[published]limit[5]]">
      <div class="article-item">
        <span class="article-date"><$view field="published" format="date" template="YYYY-MM-DD"/></span>
        <$link class="article-title"><$view field="title"/></$link>
      </div>
    </$list>
    <a href="/articles.html" class="view-all">View all articles →</a>

    <h2 class="section-title">Tags</h2>
    <div class="article-tags">
      <$list filter="[has:field[published]!has:field[pixelfed]tags[]!prefix[pf:]sort[title]]:sort:number:reverse[tagging[]has:field[published]!has:field[pixelfed]count[]]">
        <a href={{{ [<currentTiddler>addprefix[/tags/]addsuffix[.html]] }}} class="tag">
          #<$view field="title"/> [<$count filter="[has:field[published]!has:field[pixelfed]tag<currentTiddler>]"/>]
        </a>
      </$list>
    </div>
  </div>

  <div class="photos-column" id="gallery">
    <h2 class="section-title">Latest Photos</h2>
    <div class="gallery-grid">
      <$list filter="[has:field[pixelfed]has:field[published]!sort[published]limit[8]]">
        <div class="gallery-item">
          <$link>
            <$set name=imgurl filter="[all[current]get:field[thumbnail]] :else[all[current]get:field[image]]">
              <img src=<<imgurl>> alt={{!!title}} />
            </$set>
          </$link>
        </div>
      </$list>
    </div>
    <a href="/gallery.html" class="view-all">View all photos →</a>

    <h2 class="section-title" style="margin-top: 2rem;">Photo Tags</h2>
    <div class="article-tags">
      <$list filter="[has:field[pixelfed]has:field[published]tags[]prefix[pf:]sort[title]]:sort:number:reverse[tagging[]has:field[pixelfed]has:field[published]count[]]">
        <a href={{{ [<currentTiddler>removeprefix[pf:]addprefix[/picture-tag/]addsuffix[.html]] }}} class="tag">
          #<$text text={{{ [<currentTiddler>removeprefix[pf:]] }}} /> [<$count filter="[has:field[published]has:field[pixelfed]tag<currentTiddler>]"/>]
        </a>
      </$list>
    </div>
  </div>
</section>
