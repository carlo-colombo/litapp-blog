title: $:/plugins/litapp/blog/templates/page
type: text/vnd.tiddlywiki

\define tv-wikilink-template() /$uri_encoded$.html
\define tv-config-toolbar-icons() no
\define tv-config-toolbar-text() no
\define tv-config-toolbar-class() tc-btn-invisible
\import [[$:/core/ui/PageMacros]] [all[shadows+tiddlers]tag[$:/tags/Macro]!has[draft.of]]
`<!doctype html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
    <meta name="generator" content="TiddlyWiki" />
    <meta name="tiddlywiki-version" content="`{{$:/core/templates/version}}`" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes"/>
    <meta name="format-detection" content="telephone=no">
`<$set name="articleTitles" value={{{ [tag<currentTiddler>has:field[published]!sort[published]get[title]join[, ]] }}}>
<$set name="cleanTag" value={{{ [<currentTiddler>removeprefix[pf:]] :else[<currentTiddler>] }}}>
<$set name="tagDescription" value={{{ [<contentTemplate>match[$:/plugins/litapp/blog/templates/tag]then[Tag page for ']addsuffix<cleanTag>addsuffix[': ]addsuffix<articleTitles>] [<contentTemplate>match[$:/plugins/litapp/blog/templates/picture-tag]then[Gallery tag page for ']addsuffix<cleanTag>addsuffix[': ]addsuffix<articleTitles>] +[join[]] }}}>
<$wikify name="wikifiedDescription" output="text" text={{{ [<tagDescription>!match[]] ~[<currentTiddler>match[$:/plugins/litapp/blog/templates/home]then{$:/config/blog/subtitle}] ~[<currentTiddler>has[pixelfed]get[title]] ~[<currentTiddler>get[description]] ~[tag<currentTiddler>!title<currentTiddler>limit[1]get[text]] ~[<currentTiddler>!prefix[$:/]get[text]splitregexp[\s+]limit[20]join[ ]] }}}>
<$vars finalDescription={{{ [<wikifiedDescription>trim[]!match[]] ~[<currentTiddler>get[title]] ~[{$:/config/blog/subtitle}] }}}>
`<meta name="description" content="`<<finalDescription>>`" />
`</$vars>
</$wikify>
</$set>
</$set>
</$set>`
    <link
      href="`<<datauri "$:/plugins/litapp/blog/favicon">>`"
      rel="icon" type="image/x-icon" id="faviconLink"
      rel="shortcut icon" href="favicon.ico">
    <link rel="stylesheet" href="/static.css">
    <link rel="alternate" type="application/rss+xml" title="`{{$:/config/feeds/title}}`" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <title>`{{$:/config/blog/title}} - <$set name="cleanTitle" filter="[<currentTiddler>removeprefix[pf:]] :else[<currentTiddler>]"><$view field="caption"><$text text=<<cleanTitle>>/></$view></$set>`</title>
    `<$list filter="[{$:/config/blog/environment}match[dev]]">`
        <script>
            new EventSource('/blog-build').addEventListener('change', (e) => location.reload())
        </script>
    `</$list>`
</head>
<body data-content-template=`<<contentTemplate>>` >
    <header>
       <nav>
         <div class="site-branding">
           <a href="/" class="site-title">`{{$:/config/blog/title}}`</a>
           <p class="site-subtitle">`<$view tiddler="$:/config/blog/subtitle" format="htmlwikified"/>`</p>
         </div>
         <ul>
           <li><a href="/articles.html">Articles</a></li>
           <li><a href="/gallery.html">Gallery</a></li>
           <li><a href="/rss.xml">RSS</a></li>
         </ul>
       </nav>
    </header>
    <main>
         `<$view tiddler=<<contentTemplate>> format="htmlwikified"/>`
    </main>
    <footer>
      <div class="footer-links">
        <h4 class="sr-only">Links</h4>
        <ul>
`<$list filter="[[$:/config/blog/links]indexes[]]" variable="link-title">`
            <li>
`<$set name="link-ref" value={{{ [[$:/config/blog/links]getindex<link-title>] }}}>`
`<$list filter="[<link-ref>prefix[http]]" variable="ignore">`
                  <a href="`<<link-ref>>`" target="_blank" rel="noopener noreferrer">`<<link-title>>`</a>
`</$list>`
`<$list filter="[<link-ref>!prefix[http]]" variable="ignore">`
                  <a href="`<<link-ref>>`.html">`<<link-title>>`</a>
`</$list>`
`</$set>`
            </li>
`</$list>`
        </ul>
      </div>
      <div>
        © `<<now "YYYY">> <$view tiddler="$:/config/blog/author" />`
      </div>
      <div>
        Built with <a href="https://github.com/carlo-colombo/litapp-blog">litapp-blog</a> `{{$:/plugins/litapp/blog!!version}}`
      </div>
      <div class="build-info">
        Generated `<<now "[UTC]YYYY-0MM-0DD 0hh:0mm" >>` UTC
      </div>
    </footer>
</body>
</html>
`
