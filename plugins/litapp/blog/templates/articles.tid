caption: Articles
title: $:/plugins/litapp/blog/templates/articles
type: text/vnd.tiddlywiki

<h1 class="page-title">Articles</h1>

<div class="articles-list">
  <$list filter="[has:field[published]!has:field[pixelfed]!sort[published]]">
    <div class="article-item">
      <span class="article-date"><$view field="published" format="date" template="YYYY-MM-DD"/></span>
      <$link class="article-title"><$view field="title"/></$link>
      <$list filter="[tag<currentTiddler>] -[<currentTiddler>]" variable="excerpt-tiddler">
        <div class="article-excerpt"><$transclude tiddler=<<excerpt-tiddler>> /></div>
      </$list>
      <div class="article-tags">
        <$list filter="[is[current]tags[]]">
          <span class="tag">#<$view field="title"/></span>
        </$list>
      </div>
    </div>
  </$list>
</div>
