title: $:/plugins/litapp/blog/templates/entry
type: text/vnd.tiddlywiki

<article class="entry">
  <header class="entry-header">
    <$list filter="[is[current]!has:field[pixelfed]]">
      <h1 class="entry-title"><$view field="title"/></h1>
    </$list>
    <div class="entry-meta">
      <span class="entry-date"><$view field="published" format="date" template="DD MMM YYYY"/></span>
      <$list filter="[is[current]has:field[pixelfed]]">
        • <a href={{!!pixelfed}} target="_blank">View on Pixelfed</a>
      </$list>
    </div>
  </header>

  <div class="entry-content">
    <$list filter="[is[current]has:field[pixelfed]]">
        <img src={{!!image}} class="full-image" />
        <h1 class="entry-description"><$view field="description"/></h1>
    </$list>
    <$list filter="[is[current]!has:field[pixelfed]]">
        <$transclude mode="block"/>
    </$list>
  </div>

  <footer class="entry-footer">
    <div class="entry-tags">
      <$list filter="[is[current]tags[]!prefix[pf:]]">
        <a href={{{ [<currentTiddler>addprefix[/tags/]addsuffix[.html]] }}} class="tag">#<$view field="title"/></a>
      </$list>
      <$list filter="[is[current]tags[]prefix[pf:]]">
        <a href={{{ [<currentTiddler>removeprefix[pf:]addprefix[/picture-tag/]addsuffix[.html]] }}} class="tag">#<$text text={{{ [<currentTiddler>removeprefix[pf:]] }}} /></a>
      </$list>
    </div>
  </footer>
</article>
